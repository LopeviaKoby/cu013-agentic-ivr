# Application
APP_ENV=development
LOG_LEVEL=INFO
PORT=8080

# Google Cloud
GCP_PROJECT_ID=planillas-acv-tivit
GCP_REGION=us-east1

# Vertex AI / Gemini
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash-lite

# Firestore Session Store
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=cu013v2_sessions

# Build & Deployment (Cloud Build / Artifact Registry / Cloud Run)
ARTIFACT_REPOSITORY=cu013-containers
IMAGE_NAME=cu013-agentic-ivr
SERVICE_NAME=cu013-agente-xcally-dev
BUILD_SERVICE_ACCOUNT=cu013-cloud-build@planillas-acv-tivit.iam.gserviceaccount.com
RUNTIME_SERVICE_ACCOUNT=cu013-orchestrator-sa@planillas-acv-tivit.iam.gserviceaccount.com
